{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asv.local/buzz/skill-registry.schema.json",
  "title": "ASV Buzz Canonical Skill Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generatedAt",
    "registryRevision",
    "registryVersion",
    "skills",
    "ttlSeconds"
  ],
  "properties": {
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "registryRevision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "registryVersion": {
      "type": "integer",
      "minimum": 1
    },
    "ttlSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skill"
      }
    }
  },
  "$defs": {
    "availability": {
      "enum": ["available", "degraded", "unavailable", "unknown"]
    },
    "installationState": {
      "enum": [
        "catalogued",
        "installed",
        "callable",
        "degraded",
        "unreachable"
      ]
    },
    "stringSet": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "observedAt", "status"],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability",
        "entrypoint",
        "installationState",
        "invocationOwner",
        "observedAt",
        "runtimeIdentity",
        "sourceHost",
        "verification"
      ],
      "properties": {
        "availability": {
          "$ref": "#/$defs/availability"
        },
        "entrypoint": {
          "type": "string",
          "minLength": 1
        },
        "installationState": {
          "$ref": "#/$defs/installationState"
        },
        "invocationOwner": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "runtimeIdentity": {
          "type": "string",
          "minLength": 1
        },
        "sourceHost": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "$ref": "#/$defs/verification"
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "abstractRequirements",
        "capabilities",
        "connectors",
        "contentHash",
        "displayName",
        "observations",
        "permissions",
        "sharingPolicy",
        "skillId",
        "sourcePackage"
      ],
      "properties": {
        "abstractRequirements": {
          "$ref": "#/$defs/stringSet"
        },
        "capabilities": {
          "$ref": "#/$defs/stringSet"
        },
        "connectors": {
          "$ref": "#/$defs/stringSet"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/observation"
          }
        },
        "permissions": {
          "$ref": "#/$defs/stringSet"
        },
        "sharingPolicy": {
          "enum": ["private", "team-indexed", "portable"]
        },
        "skillId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]*$"
        },
        "sourcePackage": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
